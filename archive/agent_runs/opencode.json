      "rm -*": "deny",
      "rm * -*": "deny",
      "* rm -*": "deny",
      "xargs rm*": "deny",
      "* xargs rm*": "deny",
      "*-exec rm*": "deny",
      "*-delete*": "deny",
      "*rmtree*": "deny",
      "chmod -R*": "deny",
      "* chmod -R*": "deny",
      "chmod 777*": "deny",
      "git push*": "deny",
      "git remote*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "git config --global*": "deny",
      "pip uninstall*": "deny",
      "pip install --user*": "deny",
      "*--break-system-packages*": "deny",
      "kill -9*": "deny",
      "kill -KILL*": "deny",
      "kill -SIGKILL*": "deny",
      "kill 1": "deny",
      "kill -1*": "deny",
      "*/etc/*": "deny",
      "*/System/*": "deny",
      "*/Library/*": "deny",
      "*~/.*": "deny",
