{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "plugin": [
    [
      "opencode-goal-plugin",
      {
        "maxTurns": 400,
        "maxDurationMs": 28800000,
        "maxTokens": 30000000,
        "minDelayMs": 3000,
        "noProgressTurnsBeforePause": 4,
        "maxPromptFailures": 8,
        "persistState": true
      }
    ]
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "sudo": "deny",
      "sudo *": "deny",
      "* sudo *": "deny",
      "dd": "deny",
      "dd *": "deny",
      "* dd *": "deny",
      "mkfs": "deny",
      "mkfs *": "deny",
      "* mkfs *": "deny",
      "diskutil": "deny",
      "diskutil *": "deny",
      "* diskutil *": "deny",
      "hdiutil": "deny",
      "hdiutil *": "deny",
      "* hdiutil *": "deny",
      "launchctl": "deny",
      "launchctl *": "deny",
      "* launchctl *": "deny",
      "defaults": "deny",
      "defaults *": "deny",
      "* defaults *": "deny",
      "pmset": "deny",
      "pmset *": "deny",
      "* pmset *": "deny",
      "systemsetup": "deny",
      "systemsetup *": "deny",
      "* systemsetup *": "deny",
      "networksetup": "deny",
      "networksetup *": "deny",
      "* networksetup *": "deny",
      "scutil": "deny",
      "scutil *": "deny",
      "* scutil *": "deny",
      "csrutil": "deny",
      "csrutil *": "deny",
      "* csrutil *": "deny",
      "nvram": "deny",
      "nvram *": "deny",
      "* nvram *": "deny",
      "killall": "deny",
      "killall *": "deny",
      "* killall *": "deny",
      "pkill": "deny",
      "pkill *": "deny",
      "* pkill *": "deny",
      "reboot": "deny",
      "reboot *": "deny",
      "* reboot *": "deny",
      "shutdown": "deny",
      "shutdown *": "deny",
      "* shutdown *": "deny",
      "halt": "deny",
      "halt *": "deny",
      "* halt *": "deny",
      "osascript": "deny",
      "osascript *": "deny",
      "* osascript *": "deny",
      "chown": "deny",
      "chown *": "deny",
      "* chown *": "deny",
      "chflags": "deny",
      "chflags *": "deny",
      "* chflags *": "deny",
      "brew": "deny",
      "brew *": "deny",
      "* brew *": "deny",
      "npm": "deny",
      "npm *": "deny",
      "* npm *": "deny",
      "npx": "deny",
      "npx *": "deny",
      "* npx *": "deny",
      "pnpm": "deny",
      "pnpm *": "deny",
      "* pnpm *": "deny",
      "yarn": "deny",
      "yarn *": "deny",
      "* yarn *": "deny",
      "bun": "deny",
